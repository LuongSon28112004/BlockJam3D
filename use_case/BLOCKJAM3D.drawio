  <diagram name="BDHD-Đăng nhập" id="p_6fad0b57b42d">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_e226fed9e73b" value="&lt;p&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Người chơi&lt;/p&gt;&lt;p&gt;&lt;b&gt;Điều kiện trước:&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Ứng dụng đã được cài đặt&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;b&gt;Điều kiện sau:&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Người chơi được xác thực (Google hoặc Guest)&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Luồng sự kiện chính&lt;/h3&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;4&#x27; style=&#x27;border-collapse:collapse;&#x27;&gt;&lt;tr&gt;&lt;th&gt;Người chơi&lt;/th&gt;&lt;th&gt;Hệ thống&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Mở ứng dụng&lt;/td&gt;&lt;td&gt;2. Hiển thị màn hình đăng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Chọn Google hoặc Guest&lt;/td&gt;&lt;td&gt;4. Thực hiện xác thực&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;5. Lưu thông tin lên Firebase Firestore&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;6. Chuyển sang màn hình bản đồ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;h3&gt;Luồng sự kiện phụ&lt;/h3&gt;&lt;p&gt;3.1. Lỗi mạng → Cho phép chơi offline với chế độ Guest&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="800" as="geometry"/></mxCell>
