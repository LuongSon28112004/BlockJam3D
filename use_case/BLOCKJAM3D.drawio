  <diagram name="BDHD-Thua màn chơi" id="p_1dce0dce2c79">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_50f961772981" value="&lt;p&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Người chơi&lt;/p&gt;&lt;p&gt;&lt;b&gt;Điều kiện trước:&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Đang chơi và hết nước đi hoặc hết lượt&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;b&gt;Điều kiện sau:&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Hiển thị màn hình thua, cho phép chơi lại&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Luồng sự kiện chính&lt;/h3&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;4&#x27; style=&#x27;border-collapse:collapse;&#x27;&gt;&lt;tr&gt;&lt;th&gt;Người chơi&lt;/th&gt;&lt;th&gt;Hệ thống&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Không còn nước đi/hết lượt&lt;/td&gt;&lt;td&gt;2. Kiểm tra điều kiện thua&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;3. Tạm dừng game&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;4. Hiển thị popup thua (Restart/Thoát/Xem quảng cáo cứu)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Chọn Restart&lt;/td&gt;&lt;td&gt;6. Khởi động lại màn chơi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;h3&gt;Luồng sự kiện phụ&lt;/h3&gt;&lt;p&gt;5.1. Chọn Xem quảng cáo cứu → Tiếp tục với nước đi/lượt thêm&lt;/p&gt;&lt;p&gt;5.2. Chọn Thoát → Quay lại bản đồ&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="800" as="geometry"/></mxCell>
